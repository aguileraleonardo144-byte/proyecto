{
  "workbench.colorTheme": "SpiderVerse Miles",
  "workbench.colorCustomizations": {
    "editor.background": "#000000",
    "sideBar.background": "#000000",
    "activityBar.background": "#000000",
    "titleBar.activeBackground": "#000000",
    "statusBar.background": "#000000",
    "tab.activeBackground": "#000000",
    "tab.inactiveBackground": "#000000",
    "titleBar.activeForeground": "#FF073A",
    "activityBar.foreground": "#FF073A",
    "sideBar.foreground": "#FF073A",
    "statusBar.foreground": "#FF073A",
    "tab.activeForeground": "#FF073A",
    "tab.inactiveForeground": "#FF073A",
    "editorCursor.foreground": "#FF073A",
    "editorLineNumber.foreground": "#ff0707",
    "editorLineNumber.activeForeground": "#00ffea",
    "editor.selectionBackground": "#928b8b69",
    "minimap.background": "#000000"
  },
  "editor.tokenColorCustomizations": {
    "[SpiderVerse Miles]": {
      "textMateRules": [
        {
          "name": "1- < > / - Signos - AMARILLO NUCLEAR",
          "scope": [
            "punctuation.definition.tag.begin.html",
            "punctuation.definition.tag.end.html",
            "punctuation.definition.tag.html"
          ],
          "settings": { "foreground": "#FFFF00", "fontStyle": "bold" }
        },
        {
          "name": "2- table tr td form label input select option - Tags - AZUL ELECTRICO",
          "scope": ["entity.name.tag.html"],
          "settings": { "foreground": "#0080FF", "fontStyle": "bold" }
        },
        {
          "name": "3- border action method for type id name value - Atributos - VERDE NUCLEAR",
          "scope": ["entity.other.attribute-name.html"],
          "settings": { "foreground": "#39FF14", "fontStyle": "bold" }
        },
        {
          "name": "4- = - Igual - MAGENTA RADIOACTIVO",
          "scope": ["punctuation.separator.key-value.html"],
          "settings": { "foreground": "#FF00FF", "fontStyle": "bold" }
        },
        {
          "name": "5- '1' 'N_Control' 'number' 'text' 'date' - Valores - CYAN BRILLANTE",
          "scope": ["string.quoted.double.html", "string.quoted.single.html"],
          "settings": { "foreground": "#00FFFF", "fontStyle": "bold" }
        },
        {
          "name": "6- N° de Control Nombre Completo etc - Texto visible - BLANCO NUCLEAR",
          "scope": ["text.html.derivative"],
          "settings": { "foreground": "#b600fe", "fontStyle": "bold" }
        },
        {
          "name": "7- Comentarios <!-- --> - NARANJA RADIOACTIVO",
          "scope": ["comment.block.html", "comment.line.html"],
          "settings": { "foreground": "#FF8C00", "fontStyle": "bold" }
        }
      ]
    }
  }
}
